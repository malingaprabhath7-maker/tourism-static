---
import '../styles/global.css';
import type { Lang } from '../data/packages';
import { t, url, page } from '../data/ui';

interface Props { lang: Lang; title?: string; description?: string; path?: string; image?: string }
const { lang, title, description, path = '', image } = Astro.props;
const u = t(lang);
const other: Lang = lang === 'en' ? 'si' : 'en';
const full = title ? `${title} · Travel Lanka` : 'Travel Lanka — Sri Lanka tours';
const nav = [['tours', 'packages'], ['gallery', 'gallery'], ['plan', 'plan'], ['contact', 'contact']] as const;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description ?? u.siteDesc} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description ?? u.siteDesc} />
  {image && <meta property="og:image" content={new URL(url(image), Astro.site).href} />}
  <meta name="theme-color" content="#0f7c80" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" hreflang="en" href={new URL(page('en', path), Astro.site).href} />
  <link rel="alternate" hreflang="si" href={new URL(page('si', path), Astro.site).href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Sora:wght@600;700;800&family=Noto+Sans+Sinhala:wght@400;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    try { if (localStorage.getItem('tl-theme') === 'dark' || (!localStorage.getItem('tl-theme') && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark'); } catch (e) {}
  </script>
</head>
<body class="min-h-dvh font-sans antialiased">
  <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-5">
      <a href={page(lang)} class="flex items-center gap-2 font-display text-lg font-bold">
        <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="#0f7c80"/><path d="M8 21c3-1 5-4 8-4s5 3 8 4" stroke="#f5a524" stroke-width="2.4" fill="none" stroke-linecap="round"/><circle cx="16" cy="11" r="3.2" fill="#f5a524"/></svg>
        Travel Lanka
      </a>
      <nav class="ml-auto hidden items-center gap-1 text-sm font-semibold md:flex" aria-label="Main">
        {nav.map(([k, p]) => <a href={page(lang, p)} class={`rounded-full px-3 py-2 hover:bg-soft ${current.includes('/' + p) ? 'text-lagoon' : ''}`}>{u.nav[k]}{k === 'plan' && <span data-plan-count class="ml-1 hidden rounded-full bg-coconut px-1.5 text-xs text-ink"></span>}</a>)}
      </nav>
      <div class="ml-auto flex items-center gap-1 md:ml-2">
        <button type="button" data-currency class="rounded-full border border-line px-3 py-1.5 text-xs font-bold" aria-label={u.currency}>USD</button>
        <a href={page(other, path)} lang={other} class="rounded-full px-3 py-2 text-sm font-semibold hover:bg-soft">{u.other}</a>
        <button type="button" id="theme" class="grid size-9 place-items-center rounded-full hover:bg-soft" aria-label={u.theme}>
          <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8"/></svg>
          <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
    <nav class="flex justify-around border-t border-line text-sm font-semibold md:hidden" aria-label="Main">
      {nav.map(([k, p]) => <a href={page(lang, p)} class="px-2 py-2.5">{u.nav[k]}</a>)}
    </nav>
  </header>
  <main><slot /></main>
  <footer class="mt-20 border-t border-line bg-soft">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 py-10 text-sm text-muted md:grid-cols-2">
      <div>
        <p class="font-display text-base font-bold text-ink">Travel Lanka</p>
        <p class="mt-2 max-w-md">{u.about}</p>
      </div>
      <div class="md:text-right">
        <p>{u.footer}</p>
        <p class="mt-2"><a class="underline" href="https://malingaprabhath7-maker.github.io/malinga-portfolio/">Portfolio</a> · <a class="underline" href="https://github.com/malingaprabhath7-maker/tourism-static">Source code</a></p>
      </div>
    </div>
  </footer>
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
