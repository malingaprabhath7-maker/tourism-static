---
import type { Tour, Lang } from '../data/packages';
import { kinds } from '../data/packages';
import { t, page } from '../data/ui';
import TourImage from './TourImage.astro';
interface Props { tour: Tour; lang: Lang }
const { tour, lang } = Astro.props;
const u = t(lang);
---
<article class="group flex flex-col overflow-hidden rounded-3xl border border-line bg-bg"
  data-tour={tour.slug} data-region={tour.region} data-kinds={tour.kind.join(' ')} data-days={tour.days} data-price={tour.priceUsd}>
  <a href={page(lang, `packages/${tour.slug}`)} class="relative block aspect-[4/3] overflow-hidden" tabindex="-1" aria-hidden="true">
    <TourImage tour={tour} lang={lang} class="size-full transition duration-500 group-hover:scale-105" />
    <span class="absolute left-3 top-3 rounded-full bg-bg/90 px-2.5 py-1 text-xs font-bold">{u.day(tour.days)}</span>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-sm text-muted">{tour[lang].place}</p>
    <h3 class="mt-1 font-display text-xl font-bold leading-snug"><a href={page(lang, `packages/${tour.slug}`)} class="hover:text-lagoon">{tour[lang].title}</a></h3>
    <p class="mt-2 line-clamp-3 text-[0.95rem] leading-relaxed text-muted">{tour[lang].summary}</p>
    <ul class="mt-3 flex flex-wrap gap-1.5">{tour.kind.map((k) => <li class="tag">{kinds[k][lang]}</li>)}</ul>
    <div class="mt-auto flex items-end justify-between gap-3 pt-5">
      <p class="leading-tight"><span class="font-display text-2xl font-bold" data-usd={tour.priceUsd}>${tour.priceUsd}</span><br /><span class="text-xs text-muted">{u.perPerson}</span></p>
      <button type="button" data-save={tour.slug} data-label-save={u.save} data-label-saved={u.saved}
        class="shrink-0 whitespace-nowrap rounded-full border border-line px-3 py-1.5 text-xs font-semibold aria-pressed:border-coconut aria-pressed:bg-coconut aria-pressed:text-ink">{u.save}</button>
    </div>
  </div>
</article>
