---
import type { Lang } from '../data/packages';
import { tours } from '../data/packages';
import { t, url, page } from '../data/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const photos = tours.filter((x) => x.image);
---
<section class="mx-auto max-w-6xl px-5 pt-12">
  <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">{u.galleryTitle}</h1>
  <p class="mt-3 text-lg text-muted">{u.galleryIntro}</p>
  <div class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3">
    {photos.map((x) => (
      <figure class="mb-4 break-inside-avoid overflow-hidden rounded-3xl">
        <button type="button" class="block w-full" data-full={url(x.image!)} data-caption={`${x[lang].title} — ${x[lang].place}`} aria-label={x[lang].title}>
          <img src={url(x.image!)} alt={x.imageAlt ?? x[lang].title} loading="lazy" class="w-full transition duration-500 hover:scale-[1.03]" />
        </button>
        <figcaption class="bg-soft px-4 py-3 text-sm"><a href={page(lang, `packages/${x.slug}`)} class="font-semibold hover:text-lagoon">{x[lang].title}</a> · <span class="text-muted">{x[lang].place}</span></figcaption>
      </figure>
    ))}
  </div>
</section>
<dialog id="lightbox" class="m-auto max-h-[92vh] max-w-[92vw] rounded-3xl bg-transparent p-0 backdrop:bg-black/80">
  <form method="dialog"><button class="absolute right-3 top-3 z-10 grid size-10 place-items-center rounded-full bg-black/60 text-xl text-white" aria-label="Close">×</button></form>
  <img id="lb-img" alt="" class="max-h-[85vh] w-auto rounded-3xl" />
  <p id="lb-cap" class="mt-2 text-center text-white"></p>
</dialog>
<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement;
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((b) => b.addEventListener('click', () => {
    (document.getElementById('lb-img') as HTMLImageElement).src = b.dataset.full!;
    document.getElementById('lb-cap')!.textContent = b.dataset.caption!;
    box.showModal();
  }));
  box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
</script>
