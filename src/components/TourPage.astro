---
import type { Lang, Tour } from '../data/packages';
import { kinds, regions } from '../data/packages';
import { t, page } from '../data/ui';
import TourImage from './TourImage.astro';
interface Props { lang: Lang; tour: Tour }
const { lang, tour } = Astro.props;
const u = t(lang);
const d = tour[lang];
const { lat, lon } = tour.map;
const bbox = [lon - 0.35, lat - 0.25, lon + 0.35, lat + 0.25].join(',');
---
<article>
  <div class="relative">
    <TourImage tour={tour} lang={lang} eager class="h-[46vh] min-h-72 w-full" />
  </div>
  <div class="mx-auto max-w-6xl px-5">
    <div class="relative -mt-16 rounded-3xl border border-line bg-bg p-6 shadow-xl md:p-8">
      <a href={page(lang, 'packages')} class="text-sm font-semibold text-muted hover:text-ink">← {u.toursTitle}</a>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-muted">{d.place} · {lang === 'si' ? regions[tour.region] : tour.region}</p>
          <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">{d.title}</h1>
          <ul class="mt-3 flex flex-wrap gap-1.5"><li class="tag">{u.day(tour.days)}</li>{tour.kind.map((k) => <li class="tag">{kinds[k][lang]}</li>)}</ul>
        </div>
        <p class="text-right leading-tight"><span class="text-sm text-muted">{u.from}</span><br /><span class="font-display text-4xl font-extrabold text-lagoon" data-usd={tour.priceUsd}>${tour.priceUsd}</span><br /><span class="text-sm text-muted">{u.perPerson}</span></p>
      </div>
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_22rem]">
      <div class="space-y-12">
        <p class="text-xl leading-relaxed">{d.summary}</p>

        <section>
          <h2 class="font-display text-2xl font-bold">{u.highlights}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">{d.highlights.map((h) => <li class="flex gap-3 rounded-2xl bg-soft p-4"><span class="mt-1.5 size-2 shrink-0 rounded-full bg-coconut"></span>{h}</li>)}</ul>
        </section>

        <!-- the route ribbon: each day is a stop along a dotted path -->
        <section>
          <h2 class="font-display text-2xl font-bold">{u.itinerary}</h2>
          <ol class="mt-6">
            {tour.itinerary.map((day, i) => (
              <li class="relative grid grid-cols-[3rem_1fr] gap-4 pb-8 last:pb-0">
                {i < tour.itinerary.length - 1 && <span class="absolute left-6 top-12 bottom-0 border-l-2 border-dashed border-lagoon/50" aria-hidden="true"></span>}
                <span class="grid size-12 place-items-center rounded-full bg-lagoon font-display text-lg font-bold text-white">{i + 1}</span>
                <div class="pt-1">
                  <p class="text-sm font-semibold text-lagoon">{u.dayN(i + 1)}</p>
                  <h3 class="font-display text-xl font-bold">{lang === 'si' ? day.si : day.en}</h3>
                  <p class="mt-1 leading-relaxed text-muted">{lang === 'si' ? day.siText : day.enText}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="grid gap-8 sm:grid-cols-2">
          <div><h2 class="font-display text-2xl font-bold">{u.included}</h2>
            <ul class="mt-4 space-y-2">{tour.includes[lang].map((x) => <li class="flex gap-2"><span class="text-jungle">✓</span>{x}</li>)}</ul></div>
          <div><h2 class="font-display text-2xl font-bold">{u.best}</h2><p class="mt-4 text-lg">{tour.bestMonths}</p></div>
        </section>

        <section>
          <h2 class="font-display text-2xl font-bold">{u.onMap}</h2>
          <iframe title={`${u.onMap}: ${d.title}`} loading="lazy" class="mt-4 h-80 w-full rounded-3xl border border-line"
            src={`https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`}></iframe>
        </section>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <form id="book" class="space-y-4 rounded-3xl border border-line p-6" data-title={d.title} data-price={tour.priceUsd} data-lang={lang}>
          <h2 class="font-display text-xl font-bold">{u.book}</h2>
          <div><label class="label" for="b-name">{u.name}</label><input id="b-name" name="name" required class="field" autocomplete="name" /></div>
          <div class="grid grid-cols-2 gap-3">
            <div><label class="label" for="b-date">{u.date}</label><input id="b-date" name="date" type="date" required class="field" /></div>
            <div><label class="label" for="b-people">{u.people}</label><input id="b-people" name="people" type="number" min="1" max="30" value="2" required class="field" /></div>
          </div>
          <div><label class="label" for="b-phone">{u.phone}</label><input id="b-phone" name="phone" type="tel" class="field" autocomplete="tel" /></div>
          <div><label class="label" for="b-note">{u.note}</label><textarea id="b-note" name="note" rows="2" class="field"></textarea></div>
          <p class="flex items-baseline justify-between border-t border-line pt-4"><span class="text-muted">{u.total}</span><span id="b-total" class="font-display text-2xl font-bold" data-usd={tour.priceUsd * 2}></span></p>
          <button type="submit" name="via" value="wa" class="btn btn-main w-full">{u.sendWa}</button>
          <button type="submit" name="via" value="mail" class="btn btn-line w-full">{u.sendMail}</button>
          <button type="button" data-save={tour.slug} data-label-save={u.save} data-label-saved={u.saved} class="w-full text-sm font-semibold text-lagoon hover:underline"></button>
          <p class="text-xs leading-relaxed text-muted">{u.demo} {u.rateNote}</p>
        </form>
      </aside>
    </div>
  </div>
</article>
<script>
  import { renderPrices, money } from '../scripts/site';
  const form = document.getElementById('book') as HTMLFormElement;
  const total = document.getElementById('b-total')!;
  const price = Number(form.dataset.price);
  const people = () => Math.max(1, Number((form.elements.namedItem('people') as HTMLInputElement).value) || 1);
  const update = () => { total.dataset.usd = String(price * people()); renderPrices(); };
  form.addEventListener('input', update);
  update();
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const si = form.dataset.lang === 'si';
    const lines = [
      `${si ? 'චාරිකා ඉල්ලීම' : 'Tour request'}: ${form.dataset.title}`,
      `${si ? 'නම' : 'Name'}: ${f.get('name')}`,
      `${si ? 'ආරම්භක දිනය' : 'Start date'}: ${f.get('date')}`,
      `${si ? 'පුද්ගලයින්' : 'People'}: ${people()}`,
      `${si ? 'ඇස්තමේන්තු එකතුව' : 'Estimated total'}: ${money(price * people())}`,
      f.get('phone') ? `${si ? 'දුරකථන' : 'Phone'}: ${f.get('phone')}` : '',
      f.get('note') ? `${si ? 'සටහන' : 'Note'}: ${f.get('note')}` : '',
    ].filter(Boolean).join('\n');
    const via = (e as SubmitEvent).submitter?.getAttribute('value');
    location.href = via === 'mail'
      ? `mailto:?subject=${encodeURIComponent('Tour request: ' + form.dataset.title)}&body=${encodeURIComponent(lines)}`
      : `https://wa.me/?text=${encodeURIComponent(lines)}`;
  });
</script>
