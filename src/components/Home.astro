---
import type { Lang } from '../data/packages';
import { tours, kinds, regions } from '../data/packages';
import { t, url, page } from '../data/ui';
import TourCard from './TourCard.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const featured = ['sigiriya-dambulla', 'ella-hill-country', 'yala-safari', 'mirissa-whales', 'kandy-culture', 'madu-river-bentota'].map((s) => tours.find((x) => x.slug === s)!);
const kindPhotos: Record<string, string | undefined> = { culture: 'images/temple-tooth-kandy.webp', nature: 'images/nine-arch-ella.webp', beach: 'images/beach-south.webp', wildlife: 'images/elephant-yala.webp', adventure: 'images/zipline-ella.webp' };
---
<section class="relative isolate overflow-hidden">
  <img src={url('images/balloon-dambulla.webp')} alt="" class="absolute inset-0 -z-10 size-full object-cover" fetchpriority="high" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#08262a]/90 via-[#08262a]/55 to-transparent"></div>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-24 text-white md:pb-24 md:pt-32">
    <h1 class="max-w-2xl font-display text-[clamp(2.4rem,6vw,4.4rem)] font-extrabold leading-[1.05] tracking-tight">{u.heroTitle}</h1>
    <p class="mt-5 max-w-xl text-lg text-white/85">{u.heroText}</p>
    <form action={page(lang, 'packages')} method="get" class="mt-10 grid max-w-4xl gap-3 rounded-3xl bg-bg p-3 text-ink shadow-2xl sm:grid-cols-[1fr_1fr_1fr_auto]">
      <label class="px-3 py-1.5"><span class="label">{u.where}</span>
        <select name="region" class="w-full bg-transparent font-semibold outline-none"><option value="">{u.whereAll}</option>{Object.entries(regions).map(([en, si]) => <option value={en}>{lang === 'si' ? si : en}</option>)}</select></label>
      <label class="border-line px-3 py-1.5 sm:border-l"><span class="label">{u.what}</span>
        <select name="kind" class="w-full bg-transparent font-semibold outline-none"><option value="">{u.whatAll}</option>{Object.entries(kinds).map(([k, v]) => <option value={k}>{v[lang]}</option>)}</select></label>
      <label class="border-line px-3 py-1.5 sm:border-l"><span class="label">{u.days}</span>
        <select name="days" class="w-full bg-transparent font-semibold outline-none"><option value="">{u.daysAny}</option>{[1, 2, 3].map((d) => <option value={d}>{u.day(d)}</option>)}</select></label>
      <button class="btn btn-sun rounded-2xl px-7">{u.search}</button>
    </form>
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 pt-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{u.popular}</h2>
    <a href={page(lang, 'packages')} class="font-semibold text-lagoon hover:underline">{u.allTours}</a>
  </div>
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{featured.map((tour) => <TourCard tour={tour} lang={lang} />)}</div>
</section>

<section class="mx-auto max-w-6xl px-5 pt-20">
  <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{u.byKind}</h2>
  <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-5">
    {Object.entries(kinds).map(([k, v]) => (
      <a href={page(lang, `packages?kind=${k}`)} class="group relative isolate block aspect-[3/4] overflow-hidden rounded-3xl">
        <img src={url(kindPhotos[k]!)} alt="" loading="lazy" class="absolute inset-0 -z-10 size-full object-cover transition duration-500 group-hover:scale-105" />
        <span class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 to-transparent"></span>
        <span class="absolute bottom-4 left-4 font-display text-xl font-bold text-white">{v[lang]}</span>
      </a>
    ))}
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 pt-20">
  <div class="rounded-[2rem] bg-soft p-8 md:p-12">
    <h2 class="font-display text-3xl font-bold tracking-tight">{u.whyTitle}</h2>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {u.why.map(([h, p]) => <div><h3 class="font-display text-lg font-bold text-lagoon">{h}</h3><p class="mt-2 leading-relaxed text-muted">{p}</p></div>)}
    </div>
  </div>
</section>
